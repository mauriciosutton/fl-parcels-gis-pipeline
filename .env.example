# Copy to .env and fill in. Used by `publish` (see README): uv run --env-file .env python -m flparcels publish
# Supabase Storage: Dashboard > Storage > S3 Connection. Use the S3 access key pair, not the anon/service keys.
FLPARCELS_PUBLISH_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
FLPARCELS_PUBLISH_REGION=us-east-1
FLPARCELS_PUBLISH_BUCKET=<bucket>
FLPARCELS_PUBLISH_ACCESS_KEY=<access key id>
FLPARCELS_PUBLISH_SECRET_KEY=<secret access key>
